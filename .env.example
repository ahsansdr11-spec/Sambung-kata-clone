# ==== Copy nilai ini ke Environment Variables di Vercel Dashboard ====

# Akun admin pertama (otomatis dibuat saat database pertama kali jalan)
ADMIN_USERNAME=ahsans
ADMIN_PASSWORD=ganti-password-kuat-disini

# Salt untuk hashing password (ganti dengan teks acak panjang & rahasia)
PW_SALT=ubah-ini-jadi-teks-acak-panjang-rahasia-123xyz

# === Variabel di bawah ini OTOMATIS diisi Vercel saat kamu connect Postgres ===
# POSTGRES_URL=...
# POSTGRES_PRISMA_URL=...
# POSTGRES_URL_NON_POOLING=...
# (tidak perlu diisi manual)
